*.{$BASE_DOMAIN}, {$BASE_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	# Password manager
	@vaultwarden host vaultwarden.{$BASE_DOMAIN}
	handle @vaultwarden {
		reverse_proxy vaultwarden:80
	}

	# Finance
	@firefly host firefly.{$BASE_DOMAIN}
	handle @firefly {
    # 1. Define which origins are allowed to connect (Localhost AND your original domain)
    @allowed_origins header_regexp Origin `^https?://(localhost:\d+|firefly\.home\.mizustack\.com)$`

    # 2. Intercept browser preflight OPTIONS requests
    @cors_preflight {
        method OPTIONS
        expression {header.Origin} != null
    }
    handle @cors_preflight {
        header @allowed_origins Access-Control-Allow-Origin "{http.request.header.Origin}"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, X-Requested-With"
        header Access-Control-Allow-Credentials "true"
        respond "" 204
    }

    # 3. Inject CORS headers for normal API requests (GET, POST, etc.)
    # header @allowed_origins Access-Control-Allow-Origin "{http.request.header.Origin}"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, X-Requested-With"
    header Access-Control-Allow-Credentials "true"

    # Your existing configuration lines
    header Content-Security-Policy ""
    reverse_proxy firefly_iii_core:8080
	}

	# Media
	@jellyfin host jellyfin.{$BASE_DOMAIN}
	handle @jellyfin {
		reverse_proxy jellyfin:8096
	}

	@sonarr host sonarr.{$BASE_DOMAIN}
	handle @sonarr {
		reverse_proxy sonarr:8989
	}

	@prowlarr host prowlarr.{$BASE_DOMAIN}
	handle @prowlarr {
		reverse_proxy prowlarr:9696
	}

	@qbittorrent host qbittorrent.{$BASE_DOMAIN}
	handle @qbittorrent {
		reverse_proxy qbittorrent:8080
	}

	# Monitoring
	@monitoring host monitoring.{$BASE_DOMAIN}
	handle @monitoring {
		reverse_proxy beszel:8090
	}

	# Monitoring
	@memos host memos.{$BASE_DOMAIN}
	handle @memos {
		reverse_proxy memos:5230
	}

	# Local transcription
	@speaches host speaches.{$BASE_DOMAIN}
	handle @speaches {
		reverse_proxy speaches:8000
	}

	# LLM gateway
	@bifrost host bifrost.{$BASE_DOMAIN}
	handle @bifrost {
		reverse_proxy bifrost:8080
	}

	# Object storage
	@rustfs host rustfs.{$BASE_DOMAIN}
	handle @rustfs {
		reverse_proxy rustfs-server:9001
	}

	@rustfs-s3 host rustfs-s3.{$BASE_DOMAIN}
	handle @rustfs-s3 {
		reverse_proxy rustfs-server:9000
	}

	# Service discovery dashboard
	@dashboard host {$BASE_DOMAIN}
	handle @dashboard {
		root * /srv/dashboard
		file_server
	}

	handle {
		respond 404
	}
}
