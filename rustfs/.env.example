# Copy to .env and fill in values

# Host path to store RustFS data (created if missing)
RUSTFS_PATH=./data

# Root credentials for RustFS
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change_me_please

# Set to true only if RUSTFS_PATH's filesystem doesn't support disk space
# checks (e.g. some network/NAS mounts)
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=false
