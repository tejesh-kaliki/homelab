# Copy to .env. Do not commit .env.
# DATA_DIR is the host directory the sonarr stack mounts at /data (it holds
# downloads/ and media/). Example:
DATA_DIR=/Users/you/projects/homelab/sonarr/data

AUTOMATION_ENABLED=false
ANILIST_USERNAME=
QB_USERNAME=
QB_PASSWORD=
JELLYFIN_URL=http://jellyfin:8096
# Optional. When unset, animarr writes config/secret.key on first start.
# ANIMARR_SECRET_KEY=
