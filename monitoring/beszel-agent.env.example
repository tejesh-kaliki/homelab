# Native macOS Beszel agent config for ~/.config/beszel/beszel-agent.env
#
# Use the same key and token shown by the Beszel hub when adding a system.
KEY=""
TOKEN=""

# Native macOS cannot resolve Docker-internal names such as http://beszel:8090.
# Use the public/proxied URL, or http://localhost:8090 if you expose the hub port.
HUB_URL="https://monitoring.example.com"

LISTEN="45876"

# OrbStack usually creates /var/run/docker.sock for compatibility.
# If container stats do not appear, set this to the OrbStack Docker endpoint:
#   docker context inspect orbstack --format '{{ (index .Endpoints "docker").Host }}'
# DOCKER_HOST="unix:///var/run/docker.sock"
