# Copy to .env in this directory (kept out of git, same as the other services).

# Tailscale auth key (admin console -> Settings -> Keys). Only needed on the
# first start; the node identity is then kept in the tailscale-state volume.
TS_AUTHKEY=

# Mullvad exit node to use, from `tailscale exit-node list` (needs the Mullvad
# add-on enabled for this tailnet and node), e.g. se-sto-wg-001.mullvad.ts.net
MULLVAD_EXIT_NODE=
